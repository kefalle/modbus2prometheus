            HTTP --> Controller
            HTTP --> Metrics
            Telegram --> Controller
        end

        Proxy -->|"/modbus2prometheus/"| HTTP
    end

    Modbus["Устройство Modbus RTU over TCP"]
    NodeRED["Node-RED<br/>/current_th"]
